<Window x:Class="MonitorOff.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="分屏关闭显示器" Width="560" SizeToContent="Height"
        WindowStyle="None" Background="#FFFFFF"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen" ShowInTaskbar="True"
        FontFamily="Microsoft YaHei UI" FontSize="13" Foreground="#1F2329"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
  <WindowChrome.WindowChrome>
    <!-- 普通（非分层）窗口：硬件渲染；阴影和圆角由 Win11 DWM 绘制 -->
    <WindowChrome CaptionHeight="0" ResizeBorderThickness="0" GlassFrameThickness="0,0,0,1" UseAeroCaptionButtons="False"/>
  </WindowChrome.WindowChrome>
  <Window.Resources>
    <Style x:Key="Btn" TargetType="Button">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Foreground" Value="#1F2329"/>
      <Setter Property="Background" Value="#FFFFFF"/>
      <Setter Property="BorderBrush" Value="#DCDFE4"/>
      <Setter Property="Padding" Value="12,8"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="#F9FAFB"/>
                <Setter TargetName="bd" Property="BorderBrush" Value="#C4C8CF"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="bd" Property="Background" Value="#F1F3F6"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="bd" Property="Opacity" Value="0.45"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Secondary" TargetType="Button" BasedOn="{StaticResource Btn}">
      <Setter Property="Background" Value="#F3F4F6"/>
      <Setter Property="BorderBrush" Value="#E1E4EA"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Background" Value="#E9EBEF"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="bd" Property="Background" Value="#DFE2E7"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="bd" Property="Opacity" Value="0.45"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource Btn}">
      <Setter Property="Foreground" Value="#FFFFFF"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" Background="#2B3038" CornerRadius="8" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Background" Value="#1F2329"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="bd" Property="Background" Value="#14171C"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="bd" Property="Opacity" Value="0.45"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Icon" TargetType="Button">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="#6B7280"/>
      <Setter Property="Padding" Value="9,6"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="#E9EBEF"/>
                <Setter Property="Foreground" Value="#1F2329"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="bd" Property="Background" Value="#DFE2E7"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="bd" Property="Opacity" Value="0.45"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="CloseIcon" TargetType="Button" BasedOn="{StaticResource Icon}">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="#E81123"/>
                <Setter Property="Foreground" Value="#FFFFFF"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="bd" Property="Background" Value="#C42B1C"/>
                <Setter Property="Foreground" Value="#FFFFFF"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="CheckBox">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Foreground" Value="#374151"/>
      <Setter Property="FontSize" Value="12.5"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <StackPanel Orientation="Horizontal" Background="Transparent">
              <Border x:Name="box" Width="15" Height="15" CornerRadius="4" BorderThickness="1"
                      Background="#FFFFFF" BorderBrush="#DCDFE4" VerticalAlignment="Center">
                <Path x:Name="chk" Data="M 2.5,6.8 L 5.6,9.8 L 11.2,3.5" Stroke="#FFFFFF" StrokeThickness="1.7"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                      Visibility="Collapsed"/>
              </Border>
              <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="box" Property="Background" Value="#2B3038"/>
                <Setter TargetName="box" Property="BorderBrush" Value="#2B3038"/>
                <Setter TargetName="chk" Property="Visibility" Value="Visible"/>
              </Trigger>
              <MultiTrigger>
                <MultiTrigger.Conditions>
                  <Condition Property="IsMouseOver" Value="True"/>
                  <Condition Property="IsChecked" Value="False"/>
                </MultiTrigger.Conditions>
                <Setter TargetName="box" Property="BorderBrush" Value="#9CA3AF"/>
              </MultiTrigger>
              <MultiTrigger>
                <MultiTrigger.Conditions>
                  <Condition Property="IsMouseOver" Value="True"/>
                  <Condition Property="IsChecked" Value="True"/>
                </MultiTrigger.Conditions>
                <Setter TargetName="box" Property="Background" Value="#1F2329"/>
                <Setter TargetName="box" Property="BorderBrush" Value="#1F2329"/>
              </MultiTrigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="box" Property="Opacity" Value="0.45"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <ControlTemplate x:Key="TileTpl" TargetType="Button">
      <ContentPresenter/>
    </ControlTemplate>
  </Window.Resources>

  <Border Background="#FFFFFF" BorderBrush="#E4E6EB" BorderThickness="1">
    <StackPanel>
      <Grid x:Name="TitleBar" Background="#F7F8FA" Height="48">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0">
          <Border Width="28" Height="28" CornerRadius="7" Background="#ECEEF1" VerticalAlignment="Center">
            <TextBlock Text="&#xE7F4;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#6B7280"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <TextBlock Text="分屏关闭显示器" FontSize="14.5" FontWeight="SemiBold" Foreground="#1F2329" Margin="10,0,0,0" VerticalAlignment="Center"/>
          <TextBlock Text="多屏独立控制" FontSize="11.5" Foreground="#9CA3AF" Margin="10,1,0,0" VerticalAlignment="Center"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0">
          <Button x:Name="BtnRefresh" Style="{StaticResource Icon}" ToolTip="重新检测显示器">
            <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="12"/>
          </Button>
          <Button x:Name="BtnHide" Style="{StaticResource Icon}" ToolTip="收到托盘（保持关闭和热键继续工作）">
            <TextBlock Text="&#xE921;" FontFamily="Segoe MDL2 Assets" FontSize="11"/>
          </Button>
          <Button x:Name="BtnClose" Style="{StaticResource CloseIcon}" ToolTip="收到托盘">
            <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="11"/>
          </Button>
        </StackPanel>
      </Grid>
      <Border Height="1" Background="#ECEEF1"/>

      <StackPanel Margin="18,14,18,16">
        <Grid>
          <TextBlock Text="点击选择显示器（可多选，编号从左到右）" Foreground="#6B7280" FontSize="12.5" VerticalAlignment="Center"/>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="BtnAll" Style="{StaticResource Icon}" Content="全选" Padding="8,4" FontSize="12"/>
            <Button x:Name="BtnNone" Style="{StaticResource Icon}" Content="清空" Padding="8,4" FontSize="12" Margin="2,0,0,0"/>
          </StackPanel>
        </Grid>

        <Border Margin="0,8,0,0" Background="#F7F8FA" BorderBrush="#E4E6EB" BorderThickness="1" CornerRadius="8" Padding="12">
          <Canvas x:Name="Map" Height="110"/>
        </Border>

        <Grid Margin="0,12,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/>
          </Grid.ColumnDefinitions>
          <Button x:Name="BtnOff" Grid.Column="0" Style="{StaticResource Primary}">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE7E8;" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center"/>
              <TextBlock x:Name="TxtOff" Text="关闭所选" Margin="7,0,0,0"/>
            </StackPanel>
          </Button>
          <Button x:Name="BtnOn" Grid.Column="2" Style="{StaticResource Secondary}">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE706;" FontFamily="Segoe MDL2 Assets" Foreground="#6B7280" VerticalAlignment="Center"/>
              <TextBlock x:Name="TxtOn" Text="打开所选" Margin="7,0,0,0"/>
            </StackPanel>
          </Button>
        </Grid>

        <Grid Margin="0,10,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/>
          </Grid.ColumnDefinitions>
          <Button x:Name="BtnRemote" Grid.Column="0" Style="{StaticResource Btn}" Padding="10,9" ToolTip="关闭实体屏，只打开虚拟屏 (Ctrl+Alt+F10)">
            <StackPanel HorizontalAlignment="Center">
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Border x:Name="RemoteDot" Width="6" Height="6" CornerRadius="3" Background="#4CAF73" Margin="0,0,5,0" VerticalAlignment="Center" Visibility="Collapsed"/>
                <TextBlock x:Name="TxtRemote" Text="只开虚拟屏" FontWeight="SemiBold" Foreground="#1F2329" VerticalAlignment="Center"/>
              </StackPanel>
              <TextBlock Text="Ctrl+Alt+F10" FontSize="11" Foreground="#9CA3AF" HorizontalAlignment="Center" Margin="0,2,0,0"/>
            </StackPanel>
          </Button>
          <Button x:Name="BtnVirtualOff" Grid.Column="2" Style="{StaticResource Btn}" Padding="10,9" ToolTip="只关闭虚拟屏，实体屏保持亮着 (Ctrl+Alt+F11)">
            <StackPanel HorizontalAlignment="Center">
              <TextBlock Text="只关虚拟屏" FontWeight="SemiBold" Foreground="#1F2329" HorizontalAlignment="Center"/>
              <TextBlock Text="Ctrl+Alt+F11" FontSize="11" Foreground="#9CA3AF" HorizontalAlignment="Center" Margin="0,2,0,0"/>
            </StackPanel>
          </Button>
          <Button x:Name="BtnRestore" Grid.Column="4" Style="{StaticResource Btn}" Padding="10,9" ToolTip="恢复全部显示器 (Ctrl+Alt+F12)">
            <StackPanel HorizontalAlignment="Center">
              <TextBlock Text="恢复全部" FontWeight="SemiBold" Foreground="#1F2329" HorizontalAlignment="Center"/>
              <TextBlock Text="Ctrl+Alt+F12" FontSize="11" Foreground="#9CA3AF" HorizontalAlignment="Center" Margin="0,2,0,0"/>
            </StackPanel>
          </Button>
        </Grid>

        <StackPanel Margin="2,14,0,0">
          <CheckBox x:Name="ChkPreferDetach" Content="实体屏也用「断开输出」关闭（最可靠；窗口会挪到其他屏）"/>
          <CheckBox x:Name="ChkKeepOff" Margin="0,8,0,0" Content="保持关闭：用 DDC 关的屏每 20 秒补发一次，防止自己亮起"/>
          <CheckBox x:Name="ChkAutoWake" Margin="0,8,0,0" Content="碰本机键盘鼠标时自动恢复（忽略 ToDesk 等远程操作）"/>
        </StackPanel>

        <Border Margin="0,14,0,0" Background="#F7F8FA" BorderBrush="#E4E6EB" BorderThickness="1" CornerRadius="8" Padding="12,9">
          <StackPanel>
            <DockPanel>
              <TextBlock DockPanel.Dock="Left" Text="&#xE765;" FontFamily="Segoe MDL2 Assets" Foreground="#9CA3AF" VerticalAlignment="Top" Margin="0,2,0,0"/>
              <TextBlock x:Name="TxtHotkey" Margin="8,0,0,0" Foreground="#9CA3AF" FontSize="12" TextWrapping="Wrap" Text="Ctrl+Alt+F10 只开虚拟屏 · F11 只关虚拟屏 · F12 恢复全部"/>
            </DockPanel>
            <TextBlock x:Name="TxtStatus" Margin="0,5,0,0" Foreground="#374151" FontSize="12.5" TextWrapping="Wrap" Text="就绪"/>
          </StackPanel>
        </Border>
      </StackPanel>
    </StackPanel>
  </Border>
</Window>
