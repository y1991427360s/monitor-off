<Window x:Class="MonitorOff.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="分屏关闭显示器" Width="560" SizeToContent="Height"
        WindowStyle="None" Background="#FFFFFF"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen" ShowInTaskbar="True"
        FontFamily="Microsoft YaHei UI" FontSize="13" Foreground="#1F2329"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
  <WindowChrome.WindowChrome>
    <!-- 普通（非分层）窗口：硬件渲染；阴影和圆角由 Win11 DWM 绘制 -->
    <WindowChrome CaptionHeight="0" ResizeBorderThickness="0" GlassFrameThickness="0,0,0,1" UseAeroCaptionButtons="False"/>
  </WindowChrome.WindowChrome>
  <Window.Resources>
    <Style x:Key="Btn" TargetType="Button">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Foreground" Value="#1F2329"/>
      <Setter Property="Background" Value="#FFFFFF"/>
      <Setter Property="BorderBrush" Value="#E4E6EB"/>
      <Setter Property="Padding" Value="12,7"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Background" Value="#F1F3F6"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="bd" Property="Background" Value="#E8EBF0"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="bd" Property="Opacity" Value="0.45"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource Btn}">
      <Setter Property="Foreground" Value="#FFFFFF"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" Background="#3B82F6" CornerRadius="8" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Background" Value="#2F6FE0"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="bd" Property="Background" Value="#255FC4"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="bd" Property="Opacity" Value="0.45"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Icon" TargetType="Button" BasedOn="{StaticResource Btn}">
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="#6B7280"/>
      <Setter Property="Padding" Value="10,6"/>
    </Style>
    <Style TargetType="CheckBox">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Foreground" Value="#1F2329"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <ControlTemplate x:Key="TileTpl" TargetType="Button">
      <ContentPresenter/>
    </ControlTemplate>
  </Window.Resources>

  <Border Background="#FFFFFF">
    <StackPanel>
      <Grid x:Name="TitleBar" Background="Transparent" Height="46">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0">
          <TextBlock Text="&#xE7F4;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="#3B82F6" VerticalAlignment="Center"/>
          <TextBlock Text="分屏关闭显示器" FontSize="14" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,8,0">
          <Button x:Name="BtnRefresh" Style="{StaticResource Icon}" ToolTip="重新检测显示器">
            <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="12"/>
          </Button>
          <Button x:Name="BtnHide" Style="{StaticResource Icon}" ToolTip="收到托盘（保持关闭和热键继续工作）">
            <TextBlock Text="&#xE921;" FontFamily="Segoe MDL2 Assets" FontSize="11"/>
          </Button>
          <Button x:Name="BtnClose" Style="{StaticResource Icon}" ToolTip="收到托盘">
            <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="11"/>
          </Button>
        </StackPanel>
      </Grid>
      <Border Height="1" Background="#ECEEF1"/>

      <StackPanel Margin="18,14,18,16">
        <Grid>
          <TextBlock Text="点击选择显示器（可多选，编号从左到右）" Foreground="#6B7280" VerticalAlignment="Center"/>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="BtnAll" Style="{StaticResource Icon}" Content="全选"/>
            <Button x:Name="BtnNone" Style="{StaticResource Icon}" Content="清空"/>
          </StackPanel>
        </Grid>

        <Border Margin="0,10,0,0" Background="#F7F8FA" CornerRadius="8" Padding="12">
          <Canvas x:Name="Map" Height="110"/>
        </Border>

        <Button x:Name="BtnRemote" Style="{StaticResource Btn}" Margin="0,12,0,0" HorizontalContentAlignment="Left" Padding="12,9">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
            <TextBlock Text="&#xE703;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="#3B82F6" VerticalAlignment="Center"/>
            <StackPanel Grid.Column="1" Margin="12,0,0,0">
              <TextBlock x:Name="TxtRemote" Text="远程模式：关闭全部实体屏" FontWeight="SemiBold"/>
              <TextBlock x:Name="TxtRemoteSub" Text="断开实体屏的输出（不会自己亮），虚拟屏变主屏，智能体照常运行，ToDesk 照常能看" Foreground="#6B7280" FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap"/>
            </StackPanel>
          </Grid>
        </Button>

        <Grid Margin="0,12,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/>
          </Grid.ColumnDefinitions>
          <Button x:Name="BtnOff" Grid.Column="0" Style="{StaticResource Primary}">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE7E8;" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center"/>
              <TextBlock x:Name="TxtOff" Text="关闭所选" Margin="7,0,0,0"/>
            </StackPanel>
          </Button>
          <Button x:Name="BtnOn" Grid.Column="2" Style="{StaticResource Btn}">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE706;" FontFamily="Segoe MDL2 Assets" Foreground="#6B7280" VerticalAlignment="Center"/>
              <TextBlock x:Name="TxtOn" Text="打开所选" Margin="7,0,0,0"/>
            </StackPanel>
          </Button>
          <Button x:Name="BtnRestore" Grid.Column="4" Style="{StaticResource Btn}">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE7F4;" FontFamily="Segoe MDL2 Assets" Foreground="#6B7280" VerticalAlignment="Center"/>
              <TextBlock Text="恢复全部" Margin="7,0,0,0"/>
            </StackPanel>
          </Button>
        </Grid>

        <StackPanel Margin="2,14,0,0">
          <CheckBox x:Name="ChkPreferDetach" Content="实体屏也用「断开输出」关闭（最可靠；窗口会挪到其他屏）"/>
          <CheckBox x:Name="ChkKeepOff" Margin="0,8,0,0" Content="保持关闭：用 DDC 关的屏每 20 秒补发一次，防止自己亮起"/>
          <CheckBox x:Name="ChkAutoWake" Margin="0,8,0,0" Content="碰本机键盘鼠标时自动恢复（忽略 ToDesk 等远程操作）"/>
        </StackPanel>

        <Border Margin="0,14,0,0" Background="#F7F8FA" CornerRadius="8" Padding="12,9">
          <StackPanel>
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE765;" FontFamily="Segoe MDL2 Assets" Foreground="#6B7280" VerticalAlignment="Center"/>
              <TextBlock x:Name="TxtHotkey" Margin="8,0,0,0" Foreground="#6B7280" Text="随时按 Ctrl+Alt+F12 恢复全部显示器"/>
            </StackPanel>
            <TextBlock x:Name="TxtStatus" Margin="0,6,0,0" TextWrapping="Wrap" Text="就绪"/>
          </StackPanel>
        </Border>
      </StackPanel>
    </StackPanel>
  </Border>
</Window>
